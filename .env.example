FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxxxxxx
FEISHU_TABLE_URL=https://xxx.feishu.cn/base/bascnxxxxxxxxxxxx?table=tblxxxxxxxxxxxx&view=vewxxxxxxxx

# 可选：只读取某个视图
# FEISHU_VIEW_ID=vewxxxxxxxxxxxx

# 可选：如果你的飞书字段名不同，可以在这里覆盖
FEISHU_FIELD_TITLE=标题
FEISHU_FIELD_UPLOADER=上传人
FEISHU_FIELD_TOOL=模型
FEISHU_FIELD_TYPE=类型
FEISHU_FIELD_CHINESE=中文提示词
FEISHU_FIELD_ENGLISH=英文提示词
FEISHU_FIELD_TAGS=标签
FEISHU_FIELD_COVER=封面图URL
FEISHU_FIELD_DETAIL_IMAGES=详情图片URL组
# 可选：如需详情页参考图，请先在飞书表里新增同名字段，再取消下一行注释
# FEISHU_FIELD_REFERENCE_IMAGES=参考图URL组
# 可选：如需详情说明模块，请先在飞书表里新增同名字段，再取消下面两行注释
# FEISHU_FIELD_DETAIL_TEXT=详情说明
# FEISHU_FIELD_DETAIL_CONTENT_IMAGES=详情说明图片URL组
FEISHU_FIELD_STATUS=状态
FEISHU_FIELD_SORT=排序
FEISHU_FIELD_FEATURED_SORT=精选排序
FEISHU_FIELD_CREATED_AT=发布时间

# 可选：Google Cloud Translation API Key。配置后会优先尝试 Google 翻译。
# GOOGLE_TRANSLATE_API_KEY=your-google-cloud-api-key
# GOOGLE_TRANSLATE_TIMEOUT_MS=4000

# 可选：百度翻译开放平台。配置后会作为 Google 失败时的兜底翻译。
# BAIDU_TRANSLATE_APP_ID=your-baidu-app-id
# BAIDU_TRANSLATE_SECRET_KEY=your-baidu-secret-key
# BAIDU_TRANSLATE_TIMEOUT_MS=12000

# 可选：自定义自动翻译服务。接口需接收 { text, direction }，返回 { text }。
# TRANSLATION_API_URL=https://your-translation-service/translate
# TRANSLATION_API_KEY=optional-token
# TRANSLATION_API_TIMEOUT_MS=12000

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=suyeya-prompt-images
R2_PUBLIC_BASE_URL=https://img.your-domain.com
